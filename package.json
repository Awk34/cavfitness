{
  "name": "cavfitness",
  "version": "2.0.9",
  "description": "Cav fitness scraper",
  "main": "index.js",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "tsc --project tsconfig.json && cp src/styles.css package.json pnpm-lock.yaml pnpm-workspace.yaml ./dist",
    "clean": "rm -rf ./dist",
    "run": "node ./dist/index.js",
    "run-test": "ts-node src/index.ts",
    "smoke-test": "docker run --rm -e NODE_ENV=production -e DRY_RUN=true ${DOCKER_IMAGE:-cavfitness:latest}",
    "test": "jest",
    "test:all": "jest && pnpm run build && pnpm run smoke-test"
  },
  "author": "Andrew Koroluk",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "nodemailer": "^6.10.0",
    "puppeteer": "^22.7.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-proxy": "^1.0.2",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.5",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^6.4.17",
    "jest": "^30.0.5",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
